{
  "name": "flattrace",
  "version": "0.1.0",
  "description": "Small local JSONL traces with cross-process parentage",
  "author": "Mario Hawat <4396100+kyraneth@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyraneth/flattrace.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/kyraneth/flattrace",
  "bugs": {
    "url": "https://github.com/kyraneth/flattrace/issues"
  },
  "keywords": [
    "tracing",
    "jsonl",
    "diagnostics",
    "offline",
    "profiling"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/writer.js",
  "types": "./dist/writer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js"
    }
  },
  "files": [
    "dist/writer.js",
    "dist/writer.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-docs.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
